# Copier en .env.local (jamais commite) et renseigner.

# Base Turso. En production, ces deux valeurs sont posees dans Coolify
# en variables d'execution, pas de build.
TURSO_DATABASE_URL="libsql://nom-de-la-base-organisation.aws-eu-west-1.turso.io"
TURSO_AUTH_TOKEN=""

# Bucket R2 pour les photos.
R2_COMPTE_ID=""
R2_CLE_ACCES=""
R2_CLE_SECRETE=""
R2_BUCKET="projet-volley"
# Domaine public du bucket, utilise par next/image. Sans lui, aucune source
# distante n'est autorisee, ce qui est le comportement voulu en developpement.
R2_DOMAINE_PUBLIC=""

# Adresse publique du site, pour les metadonnees et les fichiers d'agenda.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mesure d'audience Umami, sans cookie, installee sur le VPS. Variables
# d'execution dans Coolify. Vides : aucun script charge (le cas en dev).
UMAMI_URL=""
UMAMI_SITE_ID=""

# Jeton de la purge nocturne (POST /taches/purge), 32 caracteres au moins,
# variable d'execution dans Coolify. Absent : la route repond 404.
PURGE_JETON=""
